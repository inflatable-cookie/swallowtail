+"""Inactive, SDK234-only permission preparation. Never starts a runtime."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+import subprocess
+import time
+
+CANDIDATE = "/opt/hostedtoolcache/node/22.23.4/x64/bin/node"
+EXPECTED = "94efd062ed066c1a0b332e18249859c905e920eeada5df55d24c99b919629a90"
+
+
+def stable(info):
+    return [
+        info.st_dev,
+        info.st_ino,
+        info.st_uid,
+        info.st_gid,
+        info.st_size,
+        info.st_mtime_ns,
+    ]
+
+
+def persist(file, value):
+    raw = json.dumps(value, sort_keys=True).encode()
+    if len(raw) > 65536:
+        raise OSError("receipt_bound")
+    temporary = file.with_name(file.name + ".pending")
+    with temporary.open("xb") as out:
+        os.chmod(temporary, 0o600)
+        out.write(raw)
+        out.flush()
+        os.fsync(out.fileno())
+    os.replace(temporary, file)
+    fd = os.open(file.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+class Preparation:
+    def __init__(self, custody, manifest, receipt):
+        self.custody, self.manifest, self.receipt = custody, manifest, Path(receipt)
+        self.deadline = time.monotonic() + 10
+        self.children, self.fd, self.capture = [], None, None
+        self.state = None
+
+    def prerequisites(self):
+        # Complete independently pinned prerequisites, never a closureComplete flag.
+        prerequisite = self.manifest.get("bootstrapInputs")
+        if (
+            not isinstance(prerequisite, dict)
+            or not prerequisite.get("libraries")
+            or not prerequisite.get("supervisorInputs")
+        ):
+            raise OSError("trusted_host_library_loader_manifest_required")
+        self.capture = self.custody.Inputs(reserve_pipes=False)
+        self.capture.bind_ancestors(self.target)
+        for role in ("libraries", "loaderInputs", "interpreters", "supervisorInputs"):
+            if not isinstance(prerequisite.get(role), dict):
+                raise OSError("bootstrap_role_missing")
+            for name, sha in prerequisite[role].items():
+                self.capture.bind(name, sha)
+        if not {str(p) for p in self.custody.python_inputs()} <= set(
+            prerequisite["supervisorInputs"]
+        ):
+            raise OSError("supervisor_inputs_missing")
+        if os.path.exists("/etc/ld.so.preload"):
+            raise OSError("ambient_loader_preload_refused")
+        if (
+            os.path.exists("/etc/ld.so.cache")
+            and "/etc/ld.so.cache" not in prerequisite["loaderInputs"]
+        ):
+            raise OSError("loader_cache_missing")
+        self.capture.check()
+
+    def recover(self):
+        root = self.receipt.parent
+        info = root.lstat()
+        if (
+            root.resolve() != root
+            or info.st_uid != os.getuid()
+            or stat.S_IMODE(info.st_mode) != 0o700
+        ):
+            raise OSError("exclusive_private_receipt_root_required")
+        descriptor = os.open(self.receipt, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        try:
+            info = os.fstat(descriptor)
+            if (
+                not stat.S_ISREG(info.st_mode)
+                or info.st_uid != os.getuid()
+                or stat.S_IMODE(info.st_mode) != 0o600
+            ):
+                raise OSError("receipt_identity_or_mode")
+            raw = os.read(descriptor, 65537)
+        finally:
+            os.close(descriptor)
+        if len(raw) > 65536:
+            raise OSError("receipt_bound")
+        self.state = json.loads(raw)
+        self.target = Path(self.manifest["path"])
+        if (
+            self.state["path"] != str(self.target)
+            or self.state["sha256"] != self.manifest["sha256"]
+            or self.state.get("children")
+        ):
+            raise OSError("recovery_binding_or_child_settlement_unknown")
+        self.prerequisites()
+
+    def fresh(self):
+        if time.monotonic() > self.deadline:
+            raise OSError("permission_deadline")
+        info = os.fstat(self.fd)
+        if stable(info) != stable(self.target.lstat()):
+            raise OSError("permission_path_drift")
+        os.lseek(self.fd, 0, os.SEEK_SET)
+        digest = hashlib.sha256()
+        total = 0
+        while True:
+            if time.monotonic() > self.deadline:
+                raise OSError("permission_deadline")
+            data = os.read(self.fd, 65536)
+            if not data:
+                break
+            total += len(data)
+            if total > 268435456:
+                raise OSError("permission_file_bound")
+            digest.update(data)
+        if digest.hexdigest() != self.manifest["sha256"]:
+            raise OSError("permission_bytes_changed")
+        if stable(info) != stable(os.fstat(self.fd)):
+            raise OSError("permission_read_drift")
+        return info
+
+    def prepare(self):
+        if self.receipt.exists():
+            raise OSError("exclusive_receipt_required")
+        root = self.receipt.parent
+        info = root.lstat()
+        if (
+            root.resolve() != root
+            or not stat.S_ISDIR(info.st_mode)
+            or info.st_uid != os.getuid()
+            or stat.S_IMODE(info.st_mode) != 0o700
+        ):
+            raise OSError("exclusive_private_receipt_root_required")
+        self.target = Path(self.manifest["path"])
+        if (
+            self.target.resolve(strict=True) != self.target
+            or self.manifest.get("originalActivation") is not False
+        ):
+            raise OSError("permission_target_or_scope")
+        self.prerequisites()
+        self.fd = os.open(self.target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        info = self.fresh()
+        if (
+            not stat.S_ISREG(info.st_mode)
+            or info.st_uid != os.getuid()
+            or stat.S_IMODE(info.st_mode) != 0o777
+            or info.st_size != self.manifest["bytes"]
+        ):
+            raise OSError("unexpected_candidate_identity_or_mode")
+        self.state = {
+            "phase": "intent",
+            "path": str(self.target),
+            "identity": stable(info),
+            "originalMode": 0o777,
+            "targetMode": 0o755,
+            "sha256": self.manifest["sha256"],
+            "fixtureCleanup": False,
+            "runtimeExecuted": False,
+            "children": [],
+        }
+        persist(self.receipt, self.state)  # durable intent precedes the only mutation
+        self.capture.check()
+        if stable(self.fresh()) != self.state["identity"]:
+            raise OSError("pre_mutation_drift")
+        os.fchmod(self.fd, 0o755)
+        after = self.fresh()
+        if (
+            stable(after) != self.state["identity"]
+            or stat.S_IMODE(after.st_mode) != 0o755
+        ):
+            raise OSError("post_mutation_identity_unknown")
+        self.state["phase"] = "prepared"
+        persist(self.receipt, self.state)
+        return self.state
+
+    def attach_child(self, child):
+        # Host composition may retain actual Popen handles, never caller wait flags.
+        if not isinstance(child, subprocess.Popen):
+            raise OSError("actual_owned_child_required")
+        self.children.append(child)
+        self.state["children"] = [entry.pid for entry in self.children]
+        persist(self.receipt, self.state)
+
+    def cleanup(self):
+        if self.state is None:
+            self.recover()
+        try:
+            waits = []
+            for child in self.children:
+                if child.poll() is None:
+                    child.kill()
+                waits.append({"pid": child.pid, "exit": child.wait(timeout=2)})
+            if self.fd is None:
+                self.fd = os.open(
+                    self.target, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
+                )
+            self.capture.check()
+            info = self.fresh()
+            if stable(info) != self.state["identity"] or stat.S_IMODE(
+                info.st_mode
+            ) not in (0o777, 0o755):
+                raise OSError("cleanup_identity_or_mode_unknown")
+            if stat.S_IMODE(info.st_mode) == 0o755:
+                os.fchmod(self.fd, 0o777)
+            after = self.fresh()
+            if (
+                stable(after) != self.state["identity"]
+                or stat.S_IMODE(after.st_mode) != 0o777
+            ):
+                raise OSError("rollback_unproved")
+            self.state.update(
+                phase="restored", fixtureCleanup=True, ownedWaits=waits, children=[]
+            )
+            persist(self.receipt, self.state)
+            self.close()
+            return self.state
+        except BaseException:
+            self.state.update(phase="cleanup_unknown", fixtureCleanup=False)
+            persist(self.receipt, self.state)
+            raise  # retain descriptors/receipt; never remove or restore an unbound object
+
+    def close(self):
+        if any(child.poll() is None for child in self.children):
+            raise OSError("child_settlement_required")
+        if self.fd is not None:
+            os.close(self.fd)
+            self.fd = None
+        if self.capture is not None:
+            self.capture.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--manifest", required=True)
+    parser.add_argument("--manifest-sha256", required=True)
+    parser.add_argument("--receipt", required=True)
+    parser.add_argument("--cleanup-only", action="store_true")
+    args = parser.parse_args()
+    raw = Path(args.manifest).read_bytes()
+    if len(raw) > 65536 or hashlib.sha256(raw).hexdigest() != args.manifest_sha256:
+        raise OSError("manifest_binding")
+    manifest = json.loads(raw)
+    if (
+        manifest["path"] != CANDIDATE
+        or manifest["sha256"] != EXPECTED
+        or manifest["bytes"] != 124902584
+    ):
+        raise OSError("fixed_candidate_only")
+    import importlib.util
+
+    source = Path(__file__).resolve().with_name("claude-agent-sdk-probe-custody.py")
+    # The future source-immutable runner must verify the entire execution record
+    # before invoking this file; its missing manifest currently refuses earlier.
+    spec = importlib.util.spec_from_file_location("sdk_custody", source)
+    custody = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(custody)
+    preparation = Preparation(custody, manifest, args.receipt)
+    if args.cleanup_only:
+        if not Path(args.receipt).exists():
+            print(json.dumps({"noSetup": True, "runtimeExecuted": False}))
+            return
+        preparation.cleanup()
+    else:
+        try:
+            preparation.prepare()
+        finally:
+            if preparation.state is not None:
+                preparation.cleanup()
+            else:
+                preparation.close()
+    print(json.dumps(preparation.state))
+
+
+if __name__ == "__main__":
+    main()
