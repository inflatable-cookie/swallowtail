    "claude-code-darwin-arm64:2.1.319_to_2.1.321": {
      "claude": "Native CLI binary changed. The 2.1.321 release notes cover tool, hook, plugin, MCP, settings, interactive and remote-control behavior; those paths are outside this route or unreachable with empty tools and strict empty MCP. Selected help and markers are in surface-ledger.json."
    },
    "claude-code-linux-x64:2.1.319_to_2.1.321": {
      "claude": "Native CLI binary changed. The 2.1.321 Linux NFS transcript-loss correction reports a process error instead of silent success; the route maps nonzero exit to its existing typed process-failure class. The hook-counter note requires Bash or PowerShell calls, which empty tools cannot make. Other selected help and markers are in surface-ledger.json."
    },
    "claude-code:2.1.321_to_2.1.322": {
      "package.json": "npm version and optional platform dependency pins only; selected bin path and wrapper identity lookup stay the same"
    },
