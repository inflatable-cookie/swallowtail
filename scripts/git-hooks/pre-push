#!/usr/bin/env bash
# Refuse a push that changes docs, PAPERCUTS.md, or CHANGELOG.md when
# `effigy qa:docs` fails. Contract 001 is the authority; this hook is the
# enforcement. Install once with `effigy hooks:install`.
#
# Fail closed: a git error while listing the pushed paths refuses the push.
# qa:docs runs against the worktree, so the pushed commit must be HEAD and
# the worktree must be empty of tracked and untracked changes. Tag refs are
# skipped so Contract 036 annotated tags can push at a non-HEAD SHA.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

remote_name=${1:-}
zero_oid=0000000000000000000000000000000000000000
docs_touched=0
docs_oid=

path_is_checked() {
  local changed_path=$1
  case "$changed_path" in
    docs|docs/*|PAPERCUTS.md|CHANGELOG.md) return 0 ;;
  esac
  return 1
}

collect_changed_paths() {
  local local_oid=$1
  local remote_oid=$2
  local merge_base listing
  git cat-file -e "${local_oid}^{commit}" || return 1
  if [[ "$remote_oid" == "$zero_oid" ]]; then
    if merge_base=$(git merge-base "$local_oid" "${remote_name}/HEAD" 2>/dev/null); then
      listing=$(git diff --name-only "$merge_base" "$local_oid") || return 1
    elif merge_base=$(git merge-base "$local_oid" origin/main 2>/dev/null); then
      listing=$(git diff --name-only "$merge_base" "$local_oid") || return 1
    else
      listing=$(git diff-tree --no-commit-id --name-only -r "$local_oid") || return 1
    fi
  else
    git cat-file -e "${remote_oid}^{commit}" || return 1
    listing=$(git diff --name-only "$remote_oid" "$local_oid") || return 1
  fi
  printf '%s\n' "$listing"
}

while read -r local_ref local_oid _remote_ref remote_oid; do
  if [[ -z "${local_oid:-}" ]]; then
    continue
  fi
  if [[ "$local_ref" == refs/tags/* ]]; then
    continue
  fi
  if [[ "$local_oid" == "$zero_oid" ]]; then
    continue
  fi
  if ! listing=$(collect_changed_paths "$local_oid" "$remote_oid"); then
    printf 'pre-push: cannot list changed paths for %s; refusing push\n' \
      "$local_oid" >&2
    exit 1
  fi
  while IFS= read -r changed_path; do
    if [[ -z "$changed_path" ]]; then
      continue
    fi
    if path_is_checked "$changed_path"; then
      docs_touched=1
      if [[ -n "$docs_oid" && "$docs_oid" != "$local_oid" ]]; then
        printf 'pre-push: multiple docs-touching commits in one push; refusing\n' >&2
        exit 1
      fi
      docs_oid=$local_oid
      break
    fi
  done <<< "$listing"
done

if [[ "$docs_touched" -ne 1 ]]; then
  exit 0
fi

head_oid=$(git rev-parse HEAD)
if [[ "$docs_oid" != "$head_oid" ]]; then
  printf 'pre-push: pushed commit %s is not HEAD (%s); refusing so qa:docs checks the pushed tree\n' \
    "$docs_oid" "$head_oid" >&2
  exit 1
fi
if ! porcelain=$(git status --porcelain); then
  printf 'pre-push: cannot read worktree status; refusing push\n' >&2
  exit 1
fi
if [[ -n "$porcelain" ]]; then
  printf 'pre-push: worktree is not clean; refusing so qa:docs checks the pushed commit\n' >&2
  exit 1
fi

if ! command -v effigy >/dev/null 2>&1; then
  printf 'pre-push: effigy is not on PATH; cannot run qa:docs\n' >&2
  exit 1
fi

# Hook GIT_* vars pin nested git to this repo. qa:docs runs throwaway
# git (roadmap number collision tests) and must see a clean environment.
unset -v GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_QUARANTINE_PATH GIT_PREFIX

printf 'pre-push: docs, PAPERCUTS.md, or CHANGELOG.md in this push; running effigy qa:docs\n' >&2
if ! effigy qa:docs; then
  printf 'pre-push: effigy qa:docs failed; refusing push (Contract 001 closeout rule)\n' >&2
  exit 1
fi
