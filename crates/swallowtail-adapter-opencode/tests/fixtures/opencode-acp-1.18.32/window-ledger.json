  "delta_classification": {
    "1.18.30_to_1.18.31": {
      "summary": "ACP session restore/config-option semantics and reasoning message-id binding only",
      "admitted": "compatible extension; the mcpServers chain, initialize response, entrypoint/argv, permissions, cancellation, and stop reasons are byte-identical across the hop",
      "changes": [
        "session/load, session/resume, and session/fork restore model, effort variant, and mode from the durable backing session and message history, and add the `default` effort sentinel to the selectable variants",
        "session/set_config_option and unstable_setSessionModel emit a `config_option_update` session/update notification (new frame as of 1.18.31)",
        "reasoning chunks bind `messageId` to the reasoning part id instead of the message id"
      ]
    }
