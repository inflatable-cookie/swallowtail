    },
    "18.0.6->18.0.7": {
      "mapped_files": [
        "src/modes/rpc/rpc-mode.ts"
      ],
      "classification": "unmapped extension-root plumbing",
      "reason": "`loadSlashCommands` receives `session.effectiveExtensionRoots` for the `available_commands_update` lifecycle record. Swallowtail runs `--no-extensions` and treats `available_commands_update` as lifecycle, not mapped content."
    },
    "18.0.7->18.0.8": {
      "mapped_files": [
        "src/modes/rpc/rpc-client.ts"
      ],
      "classification": "unmapped client-library launcher option",
      "reason": "The embedded RpcClient gains an optional `command` launcher override. Swallowtail spawns the official CLI directly and never uses the RpcClient process launcher."
    },
    "18.0.8->18.0.9": {
      "mapped_files": [
