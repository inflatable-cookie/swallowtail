    "excludes": [
      "vendor artifact execution",
      "production or ordinary admission",
      "claim or pair-map change"
    ],
    "original_run_authorised": false,
    "original_run_token": null,
    "original_run_requires": "a launcher that supplies kernel-level confinement this harness lacks: a network namespace or egress filter, a filesystem namespace with owned mounts, a separate uid/gid, and a process supervisor or cgroup. A ledger flag or token cannot substitute for them, so original mode is refused unconditionally."
  },
  "confinement": {
    "available": [
      "the runner pins the committed admission SHA-256 in its source; a substituted ledger and a substituted peer that agree with each other are refused before any module is imported",
      "the probe creates its workspace, HOME, TMPDIR, TMP and TEMP with mkdtemp under a 0700 base directory it verifies is a real directory owned by this uid",
      "the peer carries a per-run ownership nonce that the runner receives on its command line and compares with the uid",
      "peer, native and SDK paths are resolved through realpath and refused when they escape the peer directory",
      "the wall clock is the ledger's wall_clock_seconds; a larger request is refused",
      "records are accounted against the evidence bound while the run proceeds, and the disk bound is sampled during the run",
      "the native process bound is enforced by the spawn hook and latched, so a peer that swallows the error still fails the probe",
      "the native join is mandatory: a missing join, a timed-out join or an unobserved kill is failed cleanup, every non-exit kill is retried with SIGKILL, and the evidence records the native pids so a caller can verify no child survived"
    ],
    "unavailable": [
      "network namespace or egress filter: the loopback endpoint is an observation point, not a firewall, and the harness cannot stop a peer from opening another socket",
      "filesystem namespace or mount ownership, and no separate uid/gid from the host user",
      "process cgroup or supervisor: the probe bounds and observes its own children, and a peer that forks away is outside that observation"
    ],
    "original_mode": "refused unconditionally with original_mode_unavailable; the missing capability is named above"
  },
