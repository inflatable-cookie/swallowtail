{
  "wire": "swallowtail-pi-sdk-jsonl-v1",
  "behavior_revision": "pi.sdk-sidecar-v1",
  "sidecar_entry_file": "pi-sdk-sidecar.mjs",
  "sidecar_source_tag_prefix": "swallowtail-pi-sdk-sidecar@",
  "sdk_package": "@earendil-works/pi-coding-agent",
  "sdk_version": "0.84.2",
  "sdk_exports_used": [
    "VERSION",
    "createAgentSessionRuntime",
    "createAgentSessionServices",
    "createAgentSessionFromServices",
    "SessionManager",
    "SettingsManager",
    "ModelRuntime"
  ],
  "node_runtime": "22.23.2",
  "node_requirement": ">=22.19.0",
  "compatibility_claim": "qualified_only_one_point",
  "record_types": ["command", "response", "event", "terminal", "diagnostic"],
  "commands": [
    "bootstrap",
    "session_new",
    "session_switch",
    "session_replay",
    "prompt",
    "steer",
    "follow_up",
    "abort",
    "state",
    "close"
  ],
  "events": [
    "agent_start",
    "turn_start",
    "turn_end",
    "agent_end",
    "agent_settled",
    "message_start",
    "message_end",
    "output_delta",
    "reasoning_start",
    "reasoning_delta",
    "reasoning_end",
    "tool_execution_start",
    "tool_execution_update",
    "tool_execution_end",
    "replay_item",
    "progress"
  ],
  "replay_item_kinds": ["user", "assistant", "tool_result"],
  "tools": ["read", "grep", "find", "ls"],
  "bounds": {
    "record_bytes": 1048576,
    "command_id_bytes": 128,
    "pending_commands": 16,
    "replay_items": 1024,
    "image_bytes": 1048576,
    "failure_message_bytes": 512,
    "failure_code_bytes": 96
  },
  "suppressed": [
    "extensions",
    "skills",
    "prompt_templates",
    "context_files",
    "themes",
    "settings_files",
    "model_aliases",
    "catalogue_network",
    "update_checks",
    "auto_retry",
    "auto_compaction"
  ]
}
